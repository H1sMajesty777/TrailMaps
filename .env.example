# Copy to .env and fill in. Use URL-safe secrets (e.g. `openssl rand -hex 24`):
# they are embedded in connection URLs.

# ---- Environment: dev | staging | production ----
ENVIRONMENT=production
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ---- PostgreSQL / Redis ----
POSTGRES_USER=trailmaps
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=trailmaps
REDIS_PASSWORD=change-me-redis

# ---- Backend ----
# production/staging require >= 32 random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0123456789
CORS_ORIGINS=https://localhost
WEB_CONCURRENCY=2
# First administrator (created on first start if it does not exist yet).
# In production the password must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- OSRM: map extract used to build the pedestrian routing graph ----
# Monaco is a tiny extract for local trials. Use your region from https://download.geofabrik.de
OSRM_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf

# Production: TLS termination, reverse proxy, static files, rate limiting.
# ${SERVER_NAME} is substituted by the official nginx image entrypoint (envsubst).

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=5r/s;
limit_req_status 429;

upstream backend_api {
    server backend:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 6m;
    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;

    location = /api/auth/login    { limit_req zone=auth_per_ip burst=5 nodelay; include /etc/nginx/snippets/proxy.conf; }
    location = /api/auth/register { limit_req zone=auth_per_ip burst=5 nodelay; include /etc/nginx/snippets/proxy.conf; }
    location /api/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /uploads/ {
        alias /var/www/uploads/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        autoindex off;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
